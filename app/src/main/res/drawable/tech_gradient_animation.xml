<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Secuencia de fondos con ligeros cambios de color para simular movimiento -->
    <!-- Frame 1: Deep Blue -->
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0F172A"
                android:endColor="#1E293B"
                android:angle="45"/>
        </shape>
    </item>
    <!-- Frame 2: Slight Cyan Hint -->
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0F172A"
                android:endColor="#172554"
                android:angle="45"/>
        </shape>
    </item>
    <!-- Frame 3: Return -->
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0F172A"
                android:endColor="#0F172A"
                android:angle="45"/>
        </shape>
    </item>
</animation-list>
