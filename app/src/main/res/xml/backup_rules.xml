<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad desactivada (allowBackup="false"); además se excluye explícitamente
     todo el contenido sensible por si la política cambiara. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
