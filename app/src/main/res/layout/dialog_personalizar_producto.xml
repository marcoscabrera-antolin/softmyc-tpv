<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#0F172A"
    app:strokeColor="#1E293B"
    app:strokeWidth="1.5dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!--  1. CABECERA DEL MODAL                            -->
        <!-- ================================================= -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnCloseModal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtModalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="🍔 3. Mickey" />

                <TextView
                    android:id="@+id/txtDescripcionBase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    tools:text="Lomo, queso, lechuga fresca, tomate natural y mayonesa" />

                <TextView
                    android:id="@+id/txtPrecioBase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    tools:text="Precio base: 4.50€" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseModal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#94A3B8"
                android:contentDescription="@string/cerrar" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="16dp"/>

        <!-- ================================================= -->
        <!--  2. CUERPO EN 3 TARJETAS/COLUMNAS HORIZONTALES     -->
        <!--  Layout dinámico adaptado a 85-90% de alto tablet  -->
        <!-- ================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <!-- TARJETA 1: QUITAR INGREDIENTES BASE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#0B1120"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txtTituloTarjeta1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quitar_ingredientes"
                        android:textColor="#EF4444"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollQuitar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupQuitar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="false" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 2: AÑADIR EXTRAS (A-Z) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#0B1120"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txtTituloTarjeta2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/anadir_extras"
                        android:textColor="#10B981"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollAnadir"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupAnadir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="false" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 3: SALSAS (MÁX 3) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#0B1120"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txtTituloTarjeta3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/salsas_max_3"
                        android:textColor="#F59E0B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollSalsas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupSalsas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="false" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="16dp"/>

        <!-- ================================================= -->
        <!--  3. PIE DEL MODAL (FOOTER FIJO CON TOTAL Y BOTÓN) -->
        <!-- ================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CANTIDAD (+ / -) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLessQuantity"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#334155"
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="wrap_content"
                    android:minWidth="50dp"
                    android:paddingHorizontal="8dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoreQuantity"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#334155"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- TOTAL ESTIMADO DINÁMICO -->
            <TextView
                android:id="@+id/txtTotalEstimado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Total Estimado: 4.50€" />

            <!-- BOTÓN DESTACADO AÑADIR AL CARRITO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmAdd"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:paddingHorizontal="24dp"
                android:text="@string/anadir_al_carrito"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
