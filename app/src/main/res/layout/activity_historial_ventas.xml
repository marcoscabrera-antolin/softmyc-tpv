<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/volver" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_logo_monogram"
                android:scaleType="fitCenter"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/txtTituloFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial_de_ventas"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textAllCaps="true" />
        </LinearLayout>
    </RelativeLayout>

    <!-- BIG FILTER BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnDia"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/hoy"
        android:textAllCaps="true"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnMes"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/mes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAnio"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/ano"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <!-- SEARCH BAR -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="#3B82F6"
        app:hintTextColor="#94A3B8"
        android:textColorHint="#94A3B8"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscarVentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/buscar_por_producto"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>



    <!-- TOTAL DISPLAY -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#1E293B"
        app:strokeColor="#4ADE80"
        app:strokeWidth="1dp"
        android:layout_marginBottom="24dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_periodo"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:letterSpacing="0.1"/>
                
                <TextView
                    android:id="@+id/txtTotalCaja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00€"
                    android:textColor="#4ADE80"
                    android:textSize="36sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnImprimirCierre"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/imprimir_cierre"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- LIST TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detalle_de_ventas"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- SALES LIST -->
    <ListView
        android:id="@+id/listaVentas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:clipToPadding="false"/>

</LinearLayout>
