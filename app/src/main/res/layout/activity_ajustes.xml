<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="24dp"
    android:fitsSystemWindows="true">

    <!-- CABECERA TOOLBAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:contentDescription="@string/volver" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_logo_monogram"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ajustes_de_sistema"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD MULTI-TENANT ADMIN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAdminTenantSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/conmutacion_de_restaurante_admin"
                        android:textColor="#3B82F6"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvAdminCurrentTenantInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurante Activo: La Nube Bocatería"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnCambiarTenantAdminAjustes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cambiar_de_negocio_restaurante"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:backgroundTint="#2563EB" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD CONFIGURAR IMPRESORA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/impresora_termica_local"
                        android:textColor="#3B82F6"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/configura_la_direccion_ip_y_puerto_del_t"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/etImpresoraIp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:hint="@string/ej_192_168_0_20"
                            android:textColorHint="#475569"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:backgroundTint="#3B82F6"
                            android:inputType="text" />

                        <EditText
                            android:id="@+id/etImpresoraPuerto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="9100"
                            android:textColorHint="#475569"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:backgroundTint="#3B82F6"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnProbarImpresion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/probar_ticket"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:backgroundTint="#334155" />

                        <Button
                            android:id="@+id/btnGuardarIp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/guardar_ip"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:backgroundTint="#2563EB" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD PERSONALIZAR TICKET -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalizacion_del_ticket"
                        android:textColor="#3B82F6"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nombre_comercial"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etNombreRestaurante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ej_softmyc_cafe"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:backgroundTint="#3B82F6"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/direccion_fiscal"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etDireccionFiscal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ej_av_constitucion_45_valencia"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:backgroundTint="#3B82F6"
                        android:inputType="text"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/informacion_fiscal_nif_telefono"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etInformacionFiscal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ej_nif_b_12345678_tel_960000000"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:backgroundTint="#3B82F6"
                        android:inputType="text"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tamano_de_letra_del_ticket"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <Spinner
                        android:id="@+id/spinnerTamanioLetra"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#3B82F6"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnGuardarAjustesTicket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/guardar_ajustes_de_ticket"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:backgroundTint="#2563EB" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD CONFIGURAR SERVIDOR BACKEND Y API KEY -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/servidor_backend_y_sincronizacion"
                        android:textColor="#3B82F6"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/url_base_del_servidor_api"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etBackendUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ej_https_bocaterianube_com_api_tpv_order"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:backgroundTint="#3B82F6"
                        android:inputType="textUri"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/api_key_del_tpv"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/clave_secreta_de_la_api"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:backgroundTint="#3B82F6"
                        android:inputType="textPassword"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/simbolo_de_moneda_divisa"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etSimboloMoneda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ej_o"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:backgroundTint="#3B82F6"
                        android:inputType="text"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnGuardarServidor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/guardar_servidor_y_credenciales"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:backgroundTint="#2563EB" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD IMPORTAR CARTA (CSV) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/importacion_masiva_de_carta_csv"
                        android:textColor="#3B82F6"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/carga_tus_bocadillos_de_forma_comoda_des"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnSeleccionarCsv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/seleccionar_archivo_csv"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:backgroundTint="#2563EB"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro_del_importador"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- CONSOLA DE LOGS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:orientation="vertical">

                        <ScrollView
                             android:layout_width="match_parent"
                             android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/tvLogsImportacion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/esperando_archivo"
                                android:textColor="#4ADE80"
                                android:textSize="13sp"
                                android:fontFamily="monospace" />
                        </ScrollView>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD CERRAR SESION -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sesion_de_usuario"
                        android:textColor="#F43F5E"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvUsuarioSesionInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usuario_activo_en_este_tpv_al_cerrar_ses"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnCerrarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/cerrar_sesion"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#F43F5E" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
