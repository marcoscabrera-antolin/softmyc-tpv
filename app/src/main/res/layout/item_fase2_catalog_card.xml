<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/surface_light"
    app:strokeWidth="1dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Item Name, Price & Unit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/f2_nombre_articulo"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45.00 € / UD (IVA 21%)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Quantity Counter Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_rounded_surface"
                android:padding="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="60dp"
                    android:gravity="center"
                    android:text="1.00"
                    android:textColor="@color/primary_brand"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Decimal Step Increments (Visible for continuous units like KG or Hours) -->
        <LinearLayout
            android:id="@+id/quickStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f2_paso_rapido"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStepSmall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="+0.25"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="6dp"
                app:strokeColor="@color/surface_light"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStepMedium"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="+0.50"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="6dp"
                app:strokeColor="@color/surface_light"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStepLarge"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="+1.00"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                app:strokeColor="@color/surface_light"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Modifiers ChipGroup (Extras, Tares, Exclusions) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupModifiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
