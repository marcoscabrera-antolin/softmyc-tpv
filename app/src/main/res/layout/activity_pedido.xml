<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ================================================= -->
    <!--  1. CABECERA & SECTOR DE SELECCIÓN DE PRODUCTOS  -->
    <!-- ================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#0B1120">

        <!-- CABECERA CON NAVEGACIÓN ATRÁS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="#F8FAFC"
                android:contentDescription="@string/volver"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:contentDescription="@null"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_logo_monogram"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tituloPedido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hacer_pedido"
                android:textColor="#F8FAFC"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecuperarPedido"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recuperar"
                android:textColor="#3B82F6"
                android:textSize="14sp"
                app:icon="@android:drawable/ic_menu_rotate"
                app:iconTint="#3B82F6"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVaciarPedido"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vaciar"
                android:textColor="#F87171"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- BARRA DE BÚSQUEDA / ID RÁPIDO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E293B">

            <LinearLayout
                android:id="@+id/btnIntroducirID"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                
                <ImageView
                    android:contentDescription="@null"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#64748B"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/txtTituloID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/buscar_o_introducir_id"
                        android:textColor="#E2E8F0"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                     <TextView
                        android:id="@+id/txtProductoSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BARRA HORIZONTAL DE CATEGORÍAS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:scrollbars="none"
            android:layout_marginBottom="10dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- CUADRÍCULA DE PRODUCTOS (GRID VIEW) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProductosGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B"/>

    <!-- ================================================= -->
    <!--  2. LISTA DEL TICKET EN CURSO                     -->
    <!-- ================================================= -->
    <ListView
        android:id="@+id/listaPedido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:divider="#1E293B"
        android:dividerHeight="1dp"
        android:padding="12dp"
        android:clipToPadding="false"/>
    
    <!-- ================================================= -->
    <!--  3. FOOTER CON TOTAL E IMPRESIÓN                 -->
    <!-- ================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#0B1120">

        <!-- NOTA / HORA -->
        <TextView
            android:id="@+id/txtHoraRecogida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="#F59E0B"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            tools:text="📝 Nota: Sin cebolla"/>

        <!-- TOTAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="12dp">
             <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total"
                android:textSize="16sp"
                android:textColor="#64748B"
                android:paddingBottom="4dp"/>
            <TextView
                android:id="@+id/textoTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00€"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- BOTONES IMPRIMIR Y HORA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

             <!-- BOTÓN HORA -->
              <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1E293B"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:id="@+id/btnHora"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                     <ImageView
                         android:contentDescription="@string/cd_hora_recogida"
                        android:id="@+id/txtTituloHora"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_clock"
                        app:tint="#fff"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN IMPRIMIR -->
             <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2563EB"
                app:cardElevation="4dp">
                <LinearLayout
                    android:id="@+id/btnImprimir"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:id="@+id/txtTituloImprimir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/imprimir_pedido"
                        android:textColor="#FFF"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textSize="17sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
         </LinearLayout>
     </LinearLayout>

 </LinearLayout>
