<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="#1E293B"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:id="@+id/viewSemaforo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtStockNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStockEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStockMenos"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/restar_una_unidad"
        android:minWidth="48dp"
        android:padding="0dp"
        android:text="−" />

    <EditText
        android:id="@+id/edtStockCantidad"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="120dp"
        android:gravity="center"
        android:hint="@string/sin_control"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="6"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8" />

    <Button
        android:id="@+id/btnStockMas"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/sumar_una_unidad"
        android:minWidth="48dp"
        android:padding="0dp"
        android:text="+" />
</LinearLayout>
