{
  "name": "tfg-softmyc-api",
  "version": "1.0.0",
  "description": "API REST del TFG SoftMYC: sincronización de ventas y stock con PostgreSQL (aislada por negocio con RLS).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
