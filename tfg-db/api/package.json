    "usuarios": "node scripts/usuarios.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "pg": "8.13.1",
    "zod": "3.24.1"
  }
}
